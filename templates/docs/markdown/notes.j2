{#- Footnotes. Each `add*` call returns the marker; `render` prints and clears them.
   Notes for the same `name` (e.g. an attribute's requirement condition and its
   note) share one footnote, with a `label` per part. `add_with_limit` inlines
   notes of 50 characters or less instead of adding a footnote, unless they
   would break the table row (multiline, `|`, blocks).
   Markers link to their footnote. `scope` starts a new definition: numbering
   restarts at 1 (so a definition renders the same on its page and as a
   snippet) and ids are prefixed with the definition so they stay unique. Pass
   `<kind>.<id>`: a span and an entity may share an id. -#}
{%- set ns = namespace(notes=[],index=0,scope="",scope_id="") -%}
{#- `ns` must be read for the macro to capture it; assigning alone is not enough.
   Numbering restarts when the definition id changes. The anchor prefix doubles `-`
   before turning `.` into `-`, so `myapp.job-run` and `myapp.job.run` stay distinct. -#}
{%- macro scope(id) %}{% if ns %}{% if (id or "") != ns.scope_id %}{% set ns.index = 0 %}{% endif %}{% set ns.scope_id = id or "" %}{% set ns.scope = (id | lower | replace("-", "--") | replace(".", "-")) if id else "" %}{% endif %}{% endmacro %}
{%- macro scoped_id(suffix) %}{{ ns.scope ~ "-" if ns.scope }}{{ suffix }}{% endmacro %}
{%- macro anchor(n) %}{{ scoped_id("note-" ~ n) }}{% endmacro %}
{#- Notes for the same `name` share one entry; entries are namespaces so a part is
   added in place instead of copying the list. -#}
{%- macro push(note) %}{% set part = {"label": note.label, "note": note.note} %}{% set st = namespace(pos=0) %}{% if note.name %}{% for n in ns.notes %}{% if not st.pos and n.name == note.name %}{% set st.pos = loop.index %}{% set n.parts = n.parts + [part] %}{% endif %}{% endfor %}{% endif %}{% if not st.pos %}{% set ns.notes = ns.notes + [namespace(name=note.name, parts=[part])] %}{% set st.pos = ns.notes | length %}{% endif %} [[{{ st.pos + ns.index }}]](#{{ anchor(st.pos + ns.index) }}){% endmacro %}
{%- macro add(note) %}{% if note.note %}{{ push(note) }}{% endif %}{% endmacro %}
{%- macro add_with_limit(note) %}{% set text = (note.note or "") | trim %}{% if text | length > 50 or "\n" in text or "|" in text or text.startswith('>') or text.startswith('```') %}{{ push(note) }}{% elif text %} {{ text }}{% endif %}{% endmacro %}
{%- macro block_sep(text) %}{% if text.startswith('>') or text.startswith('```') or text.startswith('|') %}{{"\n\n"}}{% else %} {% endif %}{% endmacro %}
{% macro render() %}{% if ns.notes | length > 0 %}
{%- for note in ns.notes %}
<a id="{{ anchor(ns.index+loop.index) }}"></a>{% if note.name %}**[{{ns.index+loop.index}}] `{{note.name}}`:**{% else -%}**[{{ns.index+loop.index}}]:**{%- endif -%}
{%- if note.parts | length == 1 %}{{ block_sep(note.parts[0].note | trim) }}{{ note.parts[0].note | trim }}
{%- else %}{% for p in note.parts %}{{"\n\n"}}**{{ p.label }}:**{{ block_sep(p.note | trim) }}{{ p.note | trim }}{% endfor %}
{%- endif %}
{%- if not loop.last -%}{{"\n"}}{%- endif -%}
{% endfor %}{% set ns.index = ns.notes | length + ns.index %}{% set ns.notes = [] %}
{% endif %}{% endmacro %}
