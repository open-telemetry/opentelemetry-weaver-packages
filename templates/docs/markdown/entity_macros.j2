{# Copied from https://github.com/open-telemetry/semantic-conventions/blob/v1.41.1/templates/registry/markdown/entity_macros.j2 #}
{#- Macros for simplifying creating "Entity" documentation (v2). -#}
{% import 'requirement.j2' as requirement %}
{% import 'stability.j2' as stability %}
{% import 'notes.j2' as notes %}
{% import 'attribute_macros.j2' as attrs %}
{% import 'enum_macros.j2' as enums %}
{% import 'examples_macros.j2' as examples %}
{% import 'links.j2' as links %}

{#- Entities live at `{registry_base_url}/{namespace}/entities.md`, anchored per entity id. -#}
{% macro registry_url(id) -%}
{{ params.registry_base_url }}/{{ id | split_id | list | first | kebab_case }}/entities.md#{{ links.signal_anchor(id) }}
{%- endmacro %}

{#- One entity in an association. Since weaver 0.26 it is `{type, provenance}`
   (older versions passed a bare type string). Upstream entities (`provenance.source`
   set) have no docs map, so they render unlinked. -#}
{% macro entity_link(e) -%}
{%- if e is string -%}
[`{{ e }}`]({{ registry_url(e) }})
{%- elif not (e.provenance and e.provenance.source) -%}
[`{{ e.type }}`]({{ registry_url(e.type) }})
{%- else -%}
`{{ e.type }}`
{%- endif -%}
{%- endmacro %}

{#- Bullets for a list of association expressions; `one_of` / `all_of` nest. -#}
{% macro association_list(items, indent="") -%}
{%- for e in items %}
{%- if e is mapping and e.one_of %}
{{ indent }}- one of:{{ association_list(e.one_of, indent ~ "  ") }}
{%- elif e is mapping and e.all_of %}
{{ indent }}- all of:{{ association_list(e.all_of, indent ~ "  ") }}
{%- else %}
{{ indent }}- {{ entity_link(e) }}
{%- endif %}
{%- endfor %}
{%- endmacro %}

{#- `one` or `all`: how the top-level entries of an association list combine. A
   top-level list is an implicit `one_of`; a list holding a single `one_of` /
   `all_of` is unwrapped. -#}
{% macro association_mode(entity_types) -%}
{%- set only = entity_types[0] if entity_types | length == 1 else none -%}
{%- if only is mapping and only.all_of %}all{% else %}one{% endif -%}
{%- endmacro %}

{% macro association_text(entity_types) -%}
{%- set only = entity_types[0] if entity_types | length == 1 else none -%}
{%- set items = only.all_of if (only is mapping and only.all_of) else (only.one_of if (only is mapping and only.one_of) else entity_types) -%}
SHOULD be associated with *{{ association_mode(entity_types) }} of* the following entities:
{{ association_list(items) }}
{%- endmacro %}

{#- The entities a signal should be associated with. Renders nothing when the
   signal declares none. -#}
{% macro associations(entity_types) -%}
{%- if entity_types is sequence and entity_types | length > 0 %}

**Entity Associations:** {{ association_text(entity_types) }}
{%- endif %}
{%- endmacro %}

{#- Short form for a table cell: a flat list is written out (`k8s.pod`, or
   `*one of* a, b`); a nested one becomes a footnote holding the full list. -#}
{% macro associations_cell(entity_types, notes) -%}
{%- if entity_types is sequence and entity_types | length > 0 -%}
{%- set only = entity_types[0] if entity_types | length == 1 else none -%}
{%- set items = only.all_of if (only is mapping and only.all_of) else (only.one_of if (only is mapping and only.one_of) else entity_types) -%}
{%- if items | select("mapping") | selectattr("type", "undefined") | list | length > 0 -%}
{{ notes.add({"note": association_text(entity_types)}) | trim }}
{%- elif items | length == 1 -%}
{{ entity_link(items[0]) }}
{%- else -%}
*{{ association_mode(entity_types) }} of* {% for e in items %}{% if not loop.first %}, {% endif %}{{ entity_link(e) }}{% endfor %}
{%- endif -%}
{%- endif -%}
{%- endmacro %}

{#- Create role tags #}
{% macro role_tag(role) -%}
{% if role == "identity" %}Identity
{% elif role == "description" %}Description
{% else %}Other
{% endif %}
{%- endmacro %}

{#- Header for snippets. -#}
{% macro header(entity) -%}
**Status:** {{ stability.badge(entity) | trim }}

{{ entity.brief | trim }}
{%- if entity.note %}

{{ entity.note | trim }}
{%- endif %}

**Type:** `{{ entity.type }}`

**Requirement Level:** {{ requirement.signal_level(entity.requirement_level) }}
{%- endmacro %}

{#- Render a single row on the entity table. -#}
{% macro attribute_row(attribute, notes, role) -%}
| {{ role_tag(role) | trim }} | {{ attrs.name_with_link(attribute) }} | {{ stability.badge(attribute, include_note=false) | trim }} | {{ requirement.render({"level": ("required" if role == "identity" else attribute.requirement_level), "name": attribute.key}, notes) | trim }} | {{ attrs.type(attribute) }} | {{ attrs.description(attribute, notes) }} | {{ examples.format(attribute) }}|
{%- endmacro %}

{#- Render attribute tables for entities. -#}
{% macro attribute_table(attributes, notes, role) %}{% for attribute in attributes | attribute_sort %}{{ attribute_row(attribute, notes, role) }}
{% endfor %}
{%- endmacro %}

{% macro all_attribute_table(e) -%}
{%- set id_attrs = e.identity | default([]) %}{% set desc_attrs = e.description | default([]) -%}
**Attributes:**

| Role | Key | Stability | [Requirement Level]({{ links.requirement_level_url() }}) | Value Type | Description | Example Values |
| --- | --- | --- | --- | --- | --- | --- |{%- if id_attrs | length > 0 %}
{{ attribute_table(id_attrs, notes, "identity") | trim }}{% endif %}{%- if desc_attrs | length > 0 %}
{{ attribute_table(desc_attrs, notes, "description") | trim }}{% endif %}
{%- set notes_out = notes.render() | trim %}{% if notes_out %}

{{ notes_out }}
{%- endif %}
{%- set enums_out = enums.tables((id_attrs + desc_attrs) | selectattr("type", "mapping") | list, notes) | trim %}{% if enums_out %}

{{ enums_out }}
{%- endif %}
{%- endmacro %}
