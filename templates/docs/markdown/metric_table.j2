{% import 'stability.j2' as stability %}
{% import 'notes.j2' as notes %}
{% import 'metric_macros.j2' as metrics %}
{% import 'requirement.j2' as requirement %}
{% import 'entity_macros.j2' as entities %}

{# v2 metric objects expose: name, instrument, unit, brief, note, stability, attributes, entity_associations. #}
{% macro generate(group) %}| Name | Instrument Type | Unit (UCUM) | Description | Stability | Entity Associations |
| -------- | --------------- | ----------- | -------------- | --------- | ------ |
| `{{ group.name }}` | {{ metrics.instrument(group.instrument) | trim }} | `{{ group.unit }}` | {{ group.brief | trim }}{{ notes.add({"note": group.note}) }} | {{ stability.badge(group) | trim }} | {{ entities.associations_cell(group.entity_associations, notes) }} |

**Requirement Level:** {{ requirement.signal_level(group.requirement_level) }}
{{ notes.render() }}{% endmacro %}
