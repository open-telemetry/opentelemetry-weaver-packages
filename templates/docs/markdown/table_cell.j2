{#- Makes free text safe inside one markdown table cell: escapes `|`, and joins
    the non-blank lines of multi-line text (e.g. a YAML block scalar `brief`)
    with `<br>` so the row is not split. -#}
{%- macro render(text) -%}
{%- set lines = (text | default('', true) | string).split('\n') | map('trim') | reject('eq', '') | list -%}
{{- lines | join('<br>') | replace('|', '&#124;') -}}
{%- endmacro -%}
