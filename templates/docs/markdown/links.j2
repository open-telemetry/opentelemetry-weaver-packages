{%- import 'titles.j2' as titles -%}
{# All documentation/reference URLs used by the markdown templates.

   This macro module is the single owner of every link. It only *reads* values
   from config -- no URL is hardcoded or derived here. Two independent
   categories of links, configured separately:

   * OpenTelemetry general guidance (`params.otel_*_url`): naming, recording
     errors, requirement levels. A global singleton; kept in config only so
     it is easy to update, not because it varies per registry.

   * Upstream / dependency docs (the `upstream_docs` text map): where the
     attributes this registry *imports* are documented. A per-registry choice --
     not necessarily the same project that owns the guidance above. #}

{# --- OpenTelemetry general guidance links --- #}
{% macro requirement_level_url() -%}{{ params.otel_requirement_level_url }}{%- endmacro %}
{% macro naming_recommendations_url() -%}{{ params.otel_naming_recommendations_url }}{%- endmacro %}
{% macro recording_errors_url() -%}{{ params.otel_recording_errors_url }}{%- endmacro %}
{% macro span_guidelines_url() -%}{{ params.otel_span_guidelines_url }}{%- endmacro %}

{# --- Registry page URL ---
   Root-anchored absolute links to the pages this registry generates. `signal`
   is `attributes` (the namespace page), `entities`, `spans`, `metrics` or
   `events`. `registry_layout` picks the paths, `ns` is the kebab-cased namespace:

   * `per_namespace`: `{ns}/README.md`, `{ns}/{signal}.md`, signals anchored.
   * `semconv_v1`: `{signal}/{ns}.md`, signals anchored. `ns` is renamed
     through the optional `namespace_aliases` text map.
   * `per_signal`: `{ns}/README.md`, `{ns}/{signal}/README.md` and
     `{ns}/{signal}/{id}.md`, one page per signal.

   Also used for `file_name`s in weaver.yaml. Root-anchored (not file-relative)
   so the same link resolves whether it is read from a generated registry page
   or from a snippet embedded in an arbitrary hand-written doc. #}
{% macro page_ns(namespace) -%}
{%- if params.registry_layout == "semconv_v1" -%}
{{ namespace | kebab_case | map_text("namespace_aliases") }}
{%- else -%}
{{ namespace | kebab_case }}
{%- endif -%}
{%- endmacro %}
{% macro page_path(namespace, signal) -%}
{%- set ns = page_ns(namespace) | trim -%}
{%- if params.registry_layout == "semconv_v1" -%}{{ signal }}/{{ ns }}.md
{%- elif signal == "attributes" -%}{{ ns }}/README.md
{%- elif params.registry_layout == "per_signal" -%}{{ ns }}/{{ signal }}/README.md
{%- else -%}{{ ns }}/{{ signal }}.md
{%- endif -%}
{%- endmacro %}
{% macro registry_page_url(namespace, signal) -%}
{{ params.registry_base_url }}/{{ page_path(namespace, signal) | trim }}
{%- endmacro %}
{#- `per_signal` only: the page of one signal. -#}
{% macro signal_path(id, signal) -%}
{{ page_ns(id | split_id | first) | trim }}/{{ signal }}/{{ id }}.md
{%- endmacro %}
{% macro signal_url(id, signal) -%}
{%- if params.registry_layout == "per_signal" -%}
{{ params.registry_base_url }}/{{ signal_path(id, signal) | trim }}
{%- else -%}
{{ registry_page_url(id | split_id | first, signal) | trim }}#{{ signal_anchor(id) }}
{%- endif -%}
{%- endmacro %}

{# --- Signal heading anchor ---
   Signal pages render each span/metric/event/entity as a plain heading, so the
   renderer auto-generates its id by lowercasing, dropping punctuation and
   hyphenating spaces -- no explicit `<a id>` is written. This macro reproduces
   that slug for whatever `titles.signal_heading` emitted: the code-formatted id
   (`auth.attempts` -> `authattempts`) or, under `humanize_headings`, the prose
   title (`CI/CD Pipeline Run` -> `cicd-pipeline-run`). (Attributes live in a
   table, which has no auto-anchor, so those keep an explicit kebab-cased
   `<a id>` instead.) #}
{% macro signal_anchor(id) -%}
{%- if params.humanize_headings -%}
{{ titles.signal(id) | trim | lower | replace("/", "") | replace(".", "") | replace(" ", "-") }}
{%- else -%}
{{ id | lower | replace(".", "") }}
{%- endif -%}
{%- endmacro %}

{# --- Attribute documentation URL ---
   Local attributes -- defined in this registry -- carry `provenance.path` (the
   model file they live in) and link to the attribute's row in its namespace
   page (`attributes`, anchored `#{attribute-key}`); the
   README's Attributes section anchors each key by its kebab-cased id.
   Imported attributes come from a dependency and have no `provenance.path`
   (provenance is either null or `{source: <schema_url>}`); they link to that
   dependency's own docs.

   Their url template comes from the `upstream_docs` text map, keyed by the
   dependency's schema url. One dependency or ten, it is the same lookup.

   A dependency missing from the map yields an empty url rather than a guessed
   one -- callers render the attribute unlinked. There is nothing sound to guess:
   schema urls are versioned, so any built-in fallback would keep pointing at
   whichever upstream it was written for, silently, for every dependency the map
   does not cover. #}
{% macro attribute_doc_url(attribute) -%}
{%- set ns = attribute.key | split_id | first | kebab_case -%}
{%- if attribute.provenance and attribute.provenance.path -%}
{{ registry_page_url(ns, "attributes") | trim }}#{{ attribute.key | kebab_case }}
{%- else -%}
{%- set schema_url = attribute.provenance.source if attribute.provenance else "" -%}
{{ schema_url | map_text("upstream_docs", "") | replace('{namespace}', ns) }}
{%- endif -%}
{%- endmacro %}
